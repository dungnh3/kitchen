  google.protobuf.Timestamp create_time = 3 [(google.api.field_behavior) = OUTPUT_ONLY];
}

// Get{% .E.Name %}Request is the request of Get{% .E.Name %}.
message Get{% .E.Name %}Request {
  // The {% .E.Words %} id.
  string id = 1 [(buf.validate.field).string.uuid = true];
}

// List{% .E.Names %}Request is the request of List{% .E.Names %}.
message List{% .E.Names %}Request {
  // The maximum number of {% .E.WordsPlural %} to return; 0 means the server default (50).
  int32 page_size = 1 [(buf.validate.field).int32 = {
    gte: 0
    lte: 1000
  }];
  // The next_page_token of the previous response, to get the next page.
  string page_token = 2 [(buf.validate.field).string.max_len = 512];
}

// List{% .E.Names %}Response is the response of List{% .E.Names %}.
message List{% .E.Names %}Response {
  // The {% .E.WordsPlural %} of this page.
  repeated {% .E.Name %} {% .E.Snakes %} = 1;
  // A token to get the next page; empty on the last page.
  string next_page_token = 2;
}

// Create{% .E.Name %}Request is the request of Create{% .E.Name %}.
message Create{% .E.Name %}Request {
  // The {% .E.Words %} to create; output-only fields are ignored.
  {% .E.Name %} {% .E.Snake %} = 1 [(buf.validate.field).required = true];
}

// Delete{% .E.Name %}Request is the request of Delete{% .E.Name %}.
message Delete{% .E.Name %}Request {
  // The {% .E.Words %} id.
  string id = 1 [(buf.validate.field).string.uuid = true];
}
