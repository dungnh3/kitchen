  }

  // Delete{% .E.Name %} deletes {% .E.Article %} {% .E.Words %}.
  rpc Delete{% .E.Name %}(Delete{% .E.Name %}Request) returns (google.protobuf.Empty) {
    option (google.api.http) = {delete: "/v1/{% .E.Camels %}/{id}"};
  }
