  // Create{% .E.Name %} creates {% .E.Article %} {% .E.Words %}.
  rpc Create{% .E.Name %}(Create{% .E.Name %}Request) returns ({% .E.Name %}) {
    option (google.api.http) = {
      post: "/v1/{% .E.Camels %}"
      body: "{% .E.Snake %}"
