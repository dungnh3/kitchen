package tools

import (
	"encoding/json"
	"testing"

	"github.com/dungnh3/kitchen/mcpkit"
	"github.com/dungnh3/kitchen/mcpkit/mcpkittest"
	"github.com/modelcontextprotocol/go-sdk/mcp"
)

func TestGreet(t *testing.T) {
	srv, err := mcpkit.New(&mcp.Implementation{Name: "test"})
	if err != nil {
		t.Fatal(err)
	}
	Register(srv)
	cs := mcpkittest.Connect(t, srv, "")

	tests := []struct {
		name      string
		args      map[string]any
		wantError bool
		want      string
	}{
		{"ok", map[string]any{"name": "Ana"}, false, `{"greeting":"Hello, Ana!"}`},
		{"empty", map[string]any{"name": " "}, true, ""},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			res, err := cs.CallTool(t.Context(), &mcp.CallToolParams{Name: "greet", Arguments: tt.args})
			if err != nil {
				t.Fatal(err)
			}
			if res.IsError != tt.wantError {
				t.Fatalf("IsError = %v, want %v", res.IsError, tt.wantError)
			}
			if tt.want != "" {
				got, _ := json.Marshal(res.StructuredContent)
				if string(got) != tt.want {
					t.Errorf("got %s, want %s", got, tt.want)
				}
			}
		})
	}
}
