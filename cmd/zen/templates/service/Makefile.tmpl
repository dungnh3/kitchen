VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
IMAGE   ?= {% .Name %}

# Code generators and the linter run at pinned versions with "go run", so
# nothing has to be installed. The protoc plugins are "tool" deps in go.mod.
BUF           := go run github.com/bufbuild/buf/cmd/buf@{% .Versions.Buf %}
{%- if .SQL %}
SQLC          := go run github.com/sqlc-dev/sqlc/cmd/sqlc@{% .Versions.Sqlc %}
{%- end %}
GOLANGCI_LINT := go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@{% .GolangciLintVersion %}
ZEN           := go run github.com/dungnh3/kitchen/cmd/zen@{% .CLIVersion %}
{%- if .Postgres %}

DB_URL ?= postgres://app:app@localhost:5432/app?sslmode=disable
{%- else if .MySQL %}

DB_URL ?= app:app@tcp(localhost:3306)/app?tls=false
{%- end %}
# Local runs: no auth, readable logs{% if .Compose %}, the dependencies of compose.yaml{% end %}.
LOCAL_ENV := AUTH_DISABLED=true LOG_FORMAT=text{% if .SQL %} DB_URL="$(DB_URL)"{% end %}
{%- if .Redis %}
LOCAL_ENV += REDIS_ADDRS=localhost:6379 REDIS_TLS=false
{%- end %}
{%- if .GCP %}
LOCAL_ENV += PUBSUB_EMULATOR_HOST=localhost:8085 PUBSUB_PROJECT=local PUBSUB_MAX_DELIVERY_ATTEMPTS=0
# topic:subscription pairs that "make up" creates in the emulator.
LOCAL_SUBSCRIPTIONS := {% .Name %}-items:{% .Name %}-items-worker
{%- else if .Kafka %}
LOCAL_ENV += PUBSUB_BROKERS=localhost:9092 PUBSUB_TLS=false
# Topics that "make up" creates.
LOCAL_TOPICS := {% .Name %}-items {% .Name %}-items.dlq
{%- else if .SQS %}
SQS_URL := http://localhost:9324/000000000000
LOCAL_ENV += AWS_REGION=us-east-1 AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local \
	AWS_ENDPOINT_URL_SQS=http://localhost:9324 PUBSUB_ITEMS_TOPIC=$(SQS_URL)/{% .Name %}-items
# Queues that "make up" creates.
LOCAL_QUEUES := {% .Name %}-items
{%- end %}
{%- if .PubSub %}
# "zen add consumer" adds the settings of its subscription here.
# zen:local-env
{%- end %}

.PHONY: generate build test lint check breaking run tidy docker{% if .Worker %} run-worker{% end %}{% if .Compose %} up down{% end %}{% if .SQL %} migrate-up migrate-down migrate-status{% end %}

# Regenerate gen/ from proto/{% if .SQL %} and internal/store/{% .StoreDir %}/sqlcdb from the SQL{% end %}.
# The generated code is committed; CI fails if it is stale.
generate:
	$(BUF) generate
{%- if .SQL %}
	$(SQLC) generate
{%- end %}

build:
	go build -ldflags="-X main.version=$(VERSION)" -o bin/server ./cmd/server

test:
	go test -race -count=1 ./...

lint:
	$(GOLANGCI_LINT) run ./...
	$(BUF) lint
{%- if .SQL %}
	$(SQLC) vet
{%- end %}

# Fail when a file managed by zen was edited (see .zen.yaml). Add
# ARGS=-write to update the managed files to the current template.
check:
	$(ZEN) check $(ARGS)

# Compare the API with main for breaking changes.
breaking:
	$(BUF) breaking --against '.git#branch=main'

tidy:
	go mod tidy

run:
	$(LOCAL_ENV){% if .SQL %} DB_MIGRATE_ON_START=true{% end %} go run ./cmd/server serve
{%- if .Worker %}

run-worker:
	$(LOCAL_ENV) go run ./cmd/server worker
{%- end %}
{%- if .SQL %}

migrate-up migrate-down migrate-status:
	$(LOCAL_ENV) go run ./cmd/server migrate $(@:migrate-%=%)
{%- end %}
{%- if .Compose %}

# Start the local dependencies of compose.yaml{% if .GCP %} and create the topic and
# subscription in the emulator{% else if .Kafka %} and create the topics{% else if .SQS %} and create the queue{% end %}.
up:
	docker compose up -d --wait
{%- if .GCP %}
	for pair in $(LOCAL_SUBSCRIPTIONS); do topic=$${pair%%:*}; sub=$${pair#*:}; \
		curl -sf --retry 30 --retry-connrefused --retry-delay 1 -X PUT \
			http://localhost:8085/v1/projects/local/topics/$$topic >/dev/null || exit 1; \
		curl -sf -X PUT -H 'Content-Type: application/json' \
			-d "{\"topic\":\"projects/local/topics/$$topic\",\"enableMessageOrdering\":true}" \
			http://localhost:8085/v1/projects/local/subscriptions/$$sub >/dev/null || exit 1; \
	done
{%- else if .Kafka %}
	for topic in $(LOCAL_TOPICS); do \
		docker compose exec kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 \
			--create --if-not-exists --topic $$topic >/dev/null || exit 1; \
	done
{%- else if .SQS %}
	for queue in $(LOCAL_QUEUES); do \
		curl -sf --retry 30 --retry-connrefused --retry-delay 1 \
			"http://localhost:9324/?Action=CreateQueue&QueueName=$$queue" >/dev/null || exit 1; \
	done
{%- end %}

down:
	docker compose down
{%- end %}

docker:
	docker build --build-arg VERSION=$(VERSION) -t $(IMAGE):$(VERSION) .
