# Managed by zen: "zen check" fails when this file differs from
# the version zen wrote, and "zen check -write" updates it to the
# current template. To own the file instead, remove it from "managed" in
# .zen.yaml.
name: ci
on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0 # buf breaking compares with the base branch
      - uses: actions/setup-go@d8cbb8045d7f43706b9177cceb36c1f91a6644d5 # v7.1.0
        with:
          go-version-file: go.mod
      - name: files managed by zen are not edited
        run: go run github.com/dungnh3/kitchen/cmd/zen@v0.1.0 check
      - name: generated code is up to date
        run: |
          make generate
          git diff --exit-code
          test -z "$(git status --porcelain)"
      - run: go mod tidy -diff
      - run: go vet ./...
      # The integration test starts the whole service and a MySQL container (Docker is available on ubuntu runners).
      - run: go test -race -count=1 ./...
      - uses: golangci/golangci-lint-action@ba0d7d2ec06a0ea1cb5fa41b2e4a3ab91d21278a # v9.3.0
        with:
          version: v2.15.0
      - run: go run github.com/bufbuild/buf/cmd/buf@v1.75.0 lint
      - name: no breaking API change
        if: github.event_name == 'pull_request'
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: go run github.com/bufbuild/buf/cmd/buf@v1.75.0 breaking --against ".git#ref=${BASE_SHA}"

  docker:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
      - uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: .
          push: false
          build-args: VERSION=${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
