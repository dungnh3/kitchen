# Local dependencies for "make run" and "make run-worker". Start them with
# "make up" and stop them with "make down". Not for production.
services:
  postgres:
    image: postgres:18-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: app
    ports: ["5432:5432"]
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "app"]
      interval: 2s
      retries: 30
  redis:
    image: redis:8.6-alpine
    ports: ["6379:6379"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      retries: 30
  pubsub:
    image: gcr.io/google.com/cloudsdktool/google-cloud-cli:555.0.0-emulators
    command: gcloud beta emulators pubsub start --host-port=0.0.0.0:8085 --project=local
    ports: ["8085:8085"]
