// Package app wires the service together: telemetry, database, errors,
// authentication, rate limits and the gRPC + REST server.
package app

import (
	"context"
	"errors"
	"fmt"

	"github.com/dungnh3/kitchen/auth"
	xcontext "github.com/dungnh3/kitchen/context"
	"github.com/dungnh3/kitchen/errs"
	"github.com/dungnh3/kitchen/i18n"
	"github.com/dungnh3/kitchen/log"
	"github.com/dungnh3/kitchen/ratelimit"
	ratelimitredis "github.com/dungnh3/kitchen/ratelimit/redis"
	"github.com/dungnh3/kitchen/server"
	"golang.org/x/text/language"

	"github.com/acme/shop/internal/config"
	"github.com/acme/shop/internal/service"
	"github.com/acme/shop/internal/store"
	"github.com/acme/shop/internal/store/cachestore"
	"github.com/acme/shop/internal/store/mysqlstore"
)

// Name is the service name reported in telemetry.
const Name = "shop"

// publicMethods skip authentication and rate limits: the gRPC health
// service, used by load balancers and Kubernetes probes. The HTTP probes
// /livez and /readyz are always public.
var publicMethods = []string{"/grpc.health.v1.Health/"}

// Run serves the API until ctx is cancelled, then shuts down gracefully.
// logger nil means log.Default().
func Run(ctx context.Context, cfg config.Config, logger *log.Logger, version string, opts ...Option) (err error) {
	if err := cfg.ValidateServer(); err != nil {
		return err
	}
	logger = log.OrDefault(logger)
	var o options
	for _, f := range opts {
		f(&o)
	}
	d, err := openDeps(ctx, cfg, logger, version, o)
	if err != nil {
		return err
	}
	defer func() { err = errors.Join(err, d.close(ctx)) }()

	if cfg.Database.MigrateOnStart {
		if err := migrateUp(ctx, d.db, logger); err != nil {
			return err
		}
	}

	// One store and one service per domain. "zen add domain" adds its
	// store above "zen:stores" and its service above "zen:services".
	var items store.Items = mysqlstore.NewItems(d.db)
	cached, err := cachestore.NewItems(items, d.redis, cfg.Cache.TTL, Name+":item:v1:", logger)
	if err != nil {
		return fmt.Errorf("cache: %w", err)
	}
	defer func() { err = errors.Join(err, cached.Close(context.WithoutCancel(ctx))) }()
	items = cached
	orderItems := mysqlstore.NewOrderItems(d.db)
	// zen:stores
	services := []server.Service{
		service.NewItemService(items),
		service.NewOrderItemService(orderItems),
		// zen:services
	}

	bundle, err := i18n.New(language.English, i18n.WithDefaults())
	if err != nil {
		return fmt.Errorf("i18n: %w", err)
	}
	errh := errs.NewHandler(errs.Config{Logger: logger, Localizer: bundle, Domain: cfg.ErrorDomain})

	rlCfg := ratelimit.Config{
		Default:       &ratelimit.Policy{Limits: ratelimit.DefaultLimits()},
		Skip:          publicMethods,
		Exempt:        cfg.RateLimit.Exempt,
		DryRun:        cfg.RateLimit.DryRun,
		Disabled:      cfg.RateLimit.Disabled,
		Errors:        errh,
		Logger:        logger,
		MeterProvider: d.tel.MeterProvider(),
	}
	// The limits are shared by every instance through Redis.
	rls, err := ratelimitredis.New(d.redis)
	if err != nil {
		return fmt.Errorf("rate limit: %w", err)
	}
	rlCfg.Store = ratelimit.RemoteStore(rls)
	limiter, err := ratelimit.New(rlCfg)
	if err != nil {
		return fmt.Errorf("rate limit: %w", err)
	}

	serverOpts := []server.Option{
		server.WithLogger(logger),
		server.WithVersion(version),
		server.WithErrors(errh),
		server.WithGRPCAddr(cfg.GRPCAddr),
		server.WithHTTPAddr(cfg.HTTPAddr),
		server.WithTracerProvider(d.tel.TracerProvider()),
		server.WithMeterProvider(d.tel.MeterProvider()),
		server.WithPropagator(d.tel.Propagator()),
		server.WithRateLimit(limiter),
		server.WithShutdownDelay(cfg.ShutdownDelay),
		server.WithShutdownTimeout(cfg.ShutdownTimeout),
		server.WithReadiness(d.checks()...),
		server.WithServices(services...),
	}
	if len(cfg.TrustedProxies) > 0 {
		tp, err := xcontext.NewTrustedProxies(cfg.TrustedProxies...)
		if err != nil {
			return fmt.Errorf("TRUSTED_PROXIES: %w", err)
		}
		serverOpts = append(serverOpts, server.WithTrustedProxies(tp))
	}
	if cfg.AdminAddr != "" {
		serverOpts = append(serverOpts, server.WithAdmin(cfg.AdminAddr, d.adminOptions()...))
	}
	if cfg.GRPCReflection {
		serverOpts = append(serverOpts, server.WithReflection())
	}

	if cfg.Auth.Disabled {
		logger.WarnContext(ctx, "authentication is disabled (AUTH_DISABLED=true): every caller is anonymous")
	} else {
		authn, closeAuth, err := newAuthenticator(ctx, cfg.Auth, errh, logger, d)
		if err != nil {
			return err
		}
		defer func() { err = errors.Join(err, closeAuth(context.WithoutCancel(ctx))) }()
		serverOpts = append(serverOpts, server.WithAuth(authn), server.WithUserIDFrom(auth.SubjectFromContext))
	}

	srv, err := server.New(append(serverOpts, o.server...)...)
	if err != nil {
		return err
	}
	return srv.Run(ctx)
}

// newAuthenticator verifies opaque tokens with RFC 7662 introspection. The
// answers are cached and shared by the instances through Redis for at
// most 30s, so a revoked token stops working within that time. JWTs are
// rejected: their issuer has no verifier.
func newAuthenticator(_ context.Context, cfg config.Auth, errh *errs.Handler, logger *log.Logger, d *deps) (*auth.Authenticator, func(context.Context) error, error) {
	in, err := auth.NewIntrospection(auth.IntrospectionConfig{
		Introspect: auth.RFC7662(auth.RFC7662Config{
			Endpoint:     cfg.IntrospectionURL,
			ClientID:     cfg.ClientID,
			ClientSecret: cfg.ClientSecret,
			Issuer:       cfg.Issuer,
			Audience:     cfg.Audience,
		}),
		Redis:    d.redis,
		CacheKey: []byte(cfg.CacheKey),
		Prefix:   Name + ":introspection:",
		Logger:   logger,
	})
	if err != nil {
		return nil, nil, fmt.Errorf("auth: %w", err)
	}
	authn, err := auth.New(auth.Config{
		Opaque:        in,
		Audience:      cfg.Audience,
		Public:        publicMethods,
		WriteError:    errh.WriteHTTP,
		Logger:        logger,
		MeterProvider: d.tel.MeterProvider(),
	})
	if err != nil {
		in.Close()
		return nil, nil, fmt.Errorf("auth: %w", err)
	}
	return authn, func(context.Context) error { in.Close(); return nil }, nil
}
