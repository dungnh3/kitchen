// Package pgstore is a store.Store on PostgreSQL. The queries are in
// queries.sql; "make generate" turns them into the sqlcdb package.
package pgstore

import (
	"context"

	"github.com/dungnh3/kitchen/errs"
	"github.com/dungnh3/kitchen/pg"
	outboxpgx "github.com/dungnh3/kitchen/pubsub/outbox/pgx"
	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"

	"github.com/acme/billing/internal/events"
	"github.com/acme/billing/internal/store"
	"github.com/acme/billing/internal/store/pgstore/sqlcdb"
)

// Store is a store.Store on a pgx pool.
type Store struct {
	q      *sqlcdb.Queries
	pool   *pgxpool.Pool
	outbox *outboxpgx.Store
	topic  string
}

var _ store.Store = (*Store)(nil)

// New returns a Store on pool, which the caller owns. Events are written to
// outbox, for topic, in the transaction of the change.
func New(pool *pgxpool.Pool, outbox *outboxpgx.Store, topic string) *Store {
	return &Store{q: sqlcdb.New(pool), pool: pool, outbox: outbox, topic: topic}
}

// firstID sorts before every UUID, so it starts the first page.
const firstID = "00000000-0000-0000-0000-000000000000"

// GetItem implements store.Store.
func (s *Store) GetItem(ctx context.Context, id string) (store.Item, error) {
	row, err := s.q.GetItem(ctx, id)
	if err != nil {
		// pg.MapError turns pgx.ErrNoRows into errs.ErrNotFound, constraint
		// violations into the matching errs sentinel, and so on.
		return store.Item{}, pg.MapError(err)
	}
	return item(row), nil
}

// ListItems implements store.Store.
func (s *Store) ListItems(ctx context.Context, after string, limit int32) ([]store.Item, error) {
	if after == "" {
		after = firstID
	}
	rows, err := s.q.ListItems(ctx, sqlcdb.ListItemsParams{After: after, PageLimit: limit})
	if err != nil {
		return nil, pg.MapError(err)
	}
	out := make([]store.Item, len(rows))
	for i, r := range rows {
		out[i] = item(r)
	}
	return out, nil
}

// CreateItem implements store.Store. The item and its ItemCreated event are
// written in one transaction, so the event is published if and only if the
// item is stored.
func (s *Store) CreateItem(ctx context.Context, title string) (store.Item, error) {
	var it store.Item
	err := pgx.BeginFunc(ctx, s.pool, func(tx pgx.Tx) error {
		row, err := s.q.WithTx(tx).CreateItem(ctx, title)
		if err != nil {
			return err
		}
		it = item(row)
		m, err := events.NewItemCreated(it)
		if err != nil {
			return err
		}
		return s.outbox.Enqueue(ctx, tx, s.topic, m)
	})
	if err != nil {
		return store.Item{}, pg.MapError(err)
	}
	return it, nil
}

// DeleteItem implements store.Store.
func (s *Store) DeleteItem(ctx context.Context, id string) error {
	n, err := s.q.DeleteItem(ctx, id)
	if err != nil {
		return pg.MapError(err)
	}
	if n == 0 {
		return errs.ErrNotFound
	}
	return nil
}

func item(r sqlcdb.Item) store.Item {
	return store.Item{ID: r.ID, Title: r.Title, CreateTime: r.CreateTime}
}
