package app

import (
	"context"
	"errors"
	"fmt"
	"sync"
	"time"

	leaseredis "github.com/dungnh3/kitchen/lease/redis"
	"github.com/dungnh3/kitchen/log"
	"github.com/dungnh3/kitchen/pubsub"
	"github.com/dungnh3/kitchen/pubsub/outbox"
	outboxpgx "github.com/dungnh3/kitchen/pubsub/outbox/pgx"
	"github.com/dungnh3/kitchen/server"

	"github.com/acme/billing/internal/config"
	"github.com/acme/billing/internal/consumer"
	"github.com/acme/billing/internal/job"
)

// RunWorker does the background work until ctx is cancelled, then stops
// gracefully:
//   - consumes ItemCreated events (internal/consumer);
//   - relays the transactional outbox to the broker;
//   - runs the periodic jobs (internal/job), each on one replica at a time;
//   - serves the probes, metrics and pprof on ADMIN_ADDR when it is set.
//
// logger nil means log.Default().
func RunWorker(ctx context.Context, cfg config.Config, logger *log.Logger, version string, opts ...Option) (err error) {
	if err := cfg.ValidateWorker(); err != nil {
		return err
	}
	logger = log.OrDefault(logger)
	var o options
	for _, f := range opts {
		f(&o)
	}
	d, err := openDeps(ctx, cfg, logger, version, o)
	if err != nil {
		return err
	}
	defer func() { err = errors.Join(err, d.close(ctx)) }()

	var runners []func(context.Context) error

	src, err := d.broker.Source(cfg.PubSub.ItemsTopic, cfg.PubSub.ItemsSubscription)
	if err != nil {
		return fmt.Errorf("items source: %w", err)
	}
	sub, err := pubsub.NewSubscriber(src, consumer.NewItems(logger).Handler(),
		pubsub.WithConcurrency(cfg.PubSub.Concurrency),
		pubsub.WithLogger(logger),
	)
	if err != nil {
		return fmt.Errorf("items subscriber: %w", err)
	}
	runners = append(runners, sub.Run)

	ob, err := outboxpgx.New(d.pool, outboxpgx.WithLogger(logger))
	if err != nil {
		return fmt.Errorf("outbox: %w", err)
	}
	relay, err := outbox.NewRelay(ob, d.broker, outbox.WithLogger(logger))
	if err != nil {
		return fmt.Errorf("outbox relay: %w", err)
	}
	// Listen wakes the relay as soon as a transaction enqueues an event.
	runners = append(runners, ob.Listen, relay.Run)

	locker, err := leaseredis.New(d.redis)
	if err != nil {
		return fmt.Errorf("lease: %w", err)
	}
	jobs := jobs(logger)
	runners = append(runners, func(ctx context.Context) error { return job.Run(ctx, locker, logger, jobs...) })

	if cfg.AdminAddr != "" {
		admin := server.NewAdmin(cfg.AdminAddr, append(d.adminOptions(),
			server.WithAdminChecks(d.checks()...),
			server.WithAdminLogger(logger),
			server.WithAdminVersion(version),
		)...)
		runners = append(runners, admin.Run)
	}
	logger.InfoContext(ctx, "worker started")
	err = runAll(ctx, runners...)
	logger.InfoContext(ctx, "worker stopped")
	return err
}

// jobs are the periodic jobs of the worker.
func jobs(logger *log.Logger) []job.Job {
	return []job.Job{{
		Name:  "heartbeat",
		Every: time.Minute,
		Run: func(ctx context.Context) error {
			logger.InfoContext(ctx, "heartbeat job ran")
			return nil
		},
	}}
}

// runAll runs every runner until ctx is cancelled or one of them fails,
// which cancels the others. It returns after all of them have returned.
func runAll(ctx context.Context, runners ...func(context.Context) error) error {
	ctx, cancel := context.WithCancel(ctx)
	defer cancel()
	var (
		wg   sync.WaitGroup
		mu   sync.Mutex
		errs []error
	)
	for _, run := range runners {
		wg.Go(func() {
			if err := run(ctx); err != nil {
				mu.Lock()
				errs = append(errs, err)
				mu.Unlock()
				cancel()
			}
		})
	}
	wg.Wait()
	return errors.Join(errs...)
}
