VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
IMAGE   ?= billing

# Code generators and the linter run at pinned versions with "go run", so
# nothing has to be installed. The protoc plugins are "tool" deps in go.mod.
BUF           := go run github.com/bufbuild/buf/cmd/buf@v1.75.0
SQLC          := go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1
GOLANGCI_LINT := go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0

DB_URL ?= postgres://app:app@localhost:5432/app?sslmode=disable
# Local runs: no auth, readable logs, the dependencies of compose.yaml.
LOCAL_ENV := AUTH_DISABLED=true LOG_FORMAT=text DB_URL="$(DB_URL)"
LOCAL_ENV += REDIS_ADDRS=localhost:6379 REDIS_TLS=false
LOCAL_ENV += PUBSUB_EMULATOR_HOST=localhost:8085 PUBSUB_PROJECT=local PUBSUB_MAX_DELIVERY_ATTEMPTS=0

.PHONY: generate build test lint breaking run tidy docker run-worker up down migrate-up migrate-down migrate-status

# Regenerate gen/ from proto/ and internal/store/pgstore/sqlcdb from the SQL.
# The generated code is committed; CI fails if it is stale.
generate:
	$(BUF) generate
	$(SQLC) generate

build:
	go build -ldflags="-X main.version=$(VERSION)" -o bin/server ./cmd/server

test:
	go test -race -count=1 ./...

lint:
	$(GOLANGCI_LINT) run ./...
	$(BUF) lint
	$(SQLC) vet

# Compare the API with main for breaking changes.
breaking:
	$(BUF) breaking --against '.git#branch=main'

tidy:
	go mod tidy

run:
	$(LOCAL_ENV) DB_MIGRATE_ON_START=true go run ./cmd/server serve

run-worker:
	$(LOCAL_ENV) go run ./cmd/server worker

migrate-up migrate-down migrate-status:
	$(LOCAL_ENV) go run ./cmd/server migrate $(@:migrate-%=%)

# Start the local dependencies of compose.yaml and create the topic and
# subscription in the emulator.
up:
	docker compose up -d --wait
	curl -sf --retry 30 --retry-connrefused --retry-delay 1 -X PUT \
		http://localhost:8085/v1/projects/local/topics/billing-items >/dev/null
	curl -sf -X PUT -H 'Content-Type: application/json' \
		-d '{"topic":"projects/local/topics/billing-items","enableMessageOrdering":true}' \
		http://localhost:8085/v1/projects/local/subscriptions/billing-items-worker >/dev/null

down:
	docker compose down

docker:
	docker build --build-arg VERSION=$(VERSION) -t $(IMAGE):$(VERSION) .
