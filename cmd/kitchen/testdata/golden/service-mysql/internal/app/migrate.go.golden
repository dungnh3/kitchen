package app

import (
	"context"
	"database/sql"
	"fmt"
	"io"
	"text/tabwriter"

	"github.com/dungnh3/kitchen/log"
	"github.com/dungnh3/kitchen/migrate"
	"github.com/dungnh3/kitchen/otelx/sdk"

	"github.com/acme/shop/internal/config"
	"github.com/acme/shop/migrations"
)

// Migrate runs a migration command: "up" applies every pending migration,
// "down" rolls back the last one and "status" prints the state of each
// migration to out. A lock table serializes concurrent runs.
// logger nil means log.Default().
func Migrate(ctx context.Context, cfg config.Config, logger *log.Logger, command string, out io.Writer) error {
	logger = log.OrDefault(logger)
	switch command {
	case "up", "down", "status":
	default:
		return fmt.Errorf("migrate: unknown command %q (want up, down or status)", command)
	}
	tel, err := sdk.Setup(ctx, sdk.Config{Disabled: true, NoGlobal: true})
	if err != nil {
		return err
	}
	conn, err := openDB(ctx, cfg, logger, tel)
	if err != nil {
		return err
	}
	defer func() { _ = conn.Close() }()
	if command == "up" {
		return migrateUp(ctx, conn, logger)
	}
	m, err := newMigrator(conn, logger)
	if err != nil {
		return err
	}
	defer func() { _ = m.Close() }()
	if command == "down" {
		return m.Down(ctx, 1)
	}
	statuses, err := m.Status(ctx)
	if err != nil {
		return err
	}
	tw := tabwriter.NewWriter(out, 0, 4, 2, ' ', 0)
	_, _ = fmt.Fprintln(tw, "VERSION\tSTATE\tFILE")
	for _, s := range statuses {
		_, _ = fmt.Fprintf(tw, "%d\t%s\t%s\n", s.Source.Version, s.State, s.Source.Path)
	}
	return tw.Flush()
}

func migrateUp(ctx context.Context, conn *sql.DB, logger *log.Logger) error {
	m, err := newMigrator(conn, logger)
	if err != nil {
		return err
	}
	defer func() { _ = m.Close() }()
	if err := m.Up(ctx); err != nil {
		return fmt.Errorf("migrate up: %w", err)
	}
	return nil
}

func newMigrator(conn *sql.DB, logger *log.Logger) (*migrate.Migrator, error) {
	m, err := migrate.NewMySQL(conn, migrate.Config{Source: migrations.FS, Logger: logger})
	if err != nil {
		return nil, fmt.Errorf("migrate: %w", err)
	}
	return m, nil
}
