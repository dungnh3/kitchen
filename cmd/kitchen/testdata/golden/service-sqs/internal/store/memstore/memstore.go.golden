// Package memstore is an in-memory store.Store for tests and local runs.
// Its data is lost on restart and is not shared between instances.
package memstore

import (
	"cmp"
	"context"
	"slices"
	"sync"
	"time"

	"github.com/dungnh3/kitchen/errs"
	"github.com/google/uuid"

	"github.com/acme/catalog/internal/store"
)

// Store is an in-memory store.Store. The zero value is not usable; call New.
type Store struct {
	mu    sync.RWMutex
	items map[string]store.Item
	now   func() time.Time
}

var _ store.Store = (*Store)(nil)

// New returns an empty Store.
func New() *Store {
	return &Store{items: map[string]store.Item{}, now: time.Now}
}

// GetItem implements store.Store.
func (s *Store) GetItem(_ context.Context, id string) (store.Item, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()
	it, ok := s.items[id]
	if !ok {
		return store.Item{}, errs.ErrNotFound
	}
	return it, nil
}

// ListItems implements store.Store.
func (s *Store) ListItems(_ context.Context, after string, limit int32) ([]store.Item, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()
	out := make([]store.Item, 0, len(s.items))
	for _, it := range s.items {
		if it.ID > after {
			out = append(out, it)
		}
	}
	slices.SortFunc(out, func(a, b store.Item) int { return cmp.Compare(a.ID, b.ID) })
	if len(out) > int(limit) {
		out = out[:limit]
	}
	return out, nil
}

// CreateItem implements store.Store.
func (s *Store) CreateItem(_ context.Context, title string) (store.Item, error) {
	it := store.Item{ID: uuid.NewString(), Title: title, CreateTime: s.now().UTC()}
	s.mu.Lock()
	defer s.mu.Unlock()
	s.items[it.ID] = it
	return it, nil
}

// DeleteItem implements store.Store.
func (s *Store) DeleteItem(_ context.Context, id string) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if _, ok := s.items[id]; !ok {
		return errs.ErrNotFound
	}
	delete(s.items, id)
	return nil
}
