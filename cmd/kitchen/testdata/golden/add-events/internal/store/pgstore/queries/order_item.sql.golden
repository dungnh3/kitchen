-- name: GetOrderItem :one
SELECT id, title, create_time FROM order_items WHERE id = $1;

-- name: ListOrderItems :many
SELECT id, title, create_time FROM order_items
WHERE id > sqlc.arg(after)::uuid
ORDER BY id
LIMIT sqlc.arg(page_limit);

-- name: CreateOrderItem :one
INSERT INTO order_items (title) VALUES ($1)
RETURNING id, title, create_time;

-- name: DeleteOrderItem :execrows
DELETE FROM order_items WHERE id = $1;
