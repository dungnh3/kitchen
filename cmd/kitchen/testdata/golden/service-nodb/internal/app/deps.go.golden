package app

import (
	"context"
	"errors"
	"fmt"
	"os"
	"slices"
	"time"

	"github.com/dungnh3/kitchen/log"
	kprom "github.com/dungnh3/kitchen/otelx/prometheus"
	"github.com/dungnh3/kitchen/otelx/sdk"
	"github.com/dungnh3/kitchen/server"
	"github.com/prometheus/client_golang/prometheus"
	"github.com/prometheus/client_golang/prometheus/promhttp"

	"example.com/team/edge-gateway/internal/config"
)

// Option changes how Run builds the service. Tests use
// options to listen on random ports.
type Option func(*options)

type options struct {
	server []server.Option
}

// WithServerOptions appends options to the server.
func WithServerOptions(o ...server.Option) Option {
	return func(c *options) { c.server = append(c.server, o...) }
}

// deps are the resources that the server share. close releases
// them in reverse order.
type deps struct {
	tel      *sdk.Telemetry
	registry *prometheus.Registry
	closers  []func(context.Context) error
}

func openDeps(ctx context.Context, cfg config.Config, logger *log.Logger, version string, o options) (d *deps, err error) {
	d = &deps{registry: prometheus.NewRegistry()}
	defer func() {
		if err != nil {
			err = errors.Join(err, d.close(ctx))
		}
	}()

	// Traces (and metrics, logs) go over OTLP when an endpoint is set with
	// OTEL_EXPORTER_OTLP_ENDPOINT and the other OTEL_* variables. Metrics are
	// also served in Prometheus format on the admin port.
	otlp := os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT") != "" || os.Getenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT") != ""
	telCfg := sdk.Config{
		Disabled:       !otlp && cfg.AdminAddr == "",
		Logger:         logger,
		ServiceName:    Name,
		ServiceVersion: version,
		Environment:    cfg.Env,
		// Clients on the internet must not decide what is sampled.
		IgnoreRemoteSampled: true,
	}
	if !otlp {
		telCfg.Traces.Exporter = sdk.ExporterNone
	}
	if cfg.AdminAddr != "" {
		r, err := kprom.NewReader(kprom.Options{Registerer: d.registry})
		if err != nil {
			return d, fmt.Errorf("prometheus: %w", err)
		}
		telCfg.MetricReaders = append(telCfg.MetricReaders, r)
	}
	d.tel, err = sdk.Setup(ctx, telCfg)
	if err != nil {
		return d, fmt.Errorf("telemetry: %w", err)
	}
	d.onClose(d.tel.Shutdown)
	return d, nil
}

func (d *deps) onClose(f func(context.Context) error) { d.closers = append(d.closers, f) }

// close releases the resources in reverse order of opening, within 10s
// even when ctx is already cancelled.
func (d *deps) close(ctx context.Context) error {
	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 10*time.Second)
	defer cancel()
	var err error
	for _, f := range slices.Backward(d.closers) {
		err = errors.Join(err, f(ctx))
	}
	return err
}

// checks are the readiness checks of the external services.
func (d *deps) checks() []server.Check {
	var checks []server.Check
	return checks
}

// adminOptions configure the private admin port: probes with details,
// pprof and Prometheus metrics.
func (d *deps) adminOptions() []server.AdminOption {
	return []server.AdminOption{
		server.WithPprof(),
		server.WithAdminHandler("GET /metrics", promhttp.HandlerFor(d.registry, promhttp.HandlerOpts{})),
	}
}
