package events

import (
	"context"
	"encoding/json"
	"testing"

	"github.com/dungnh3/kitchen/log"
	"github.com/dungnh3/kitchen/pubsub"
	"github.com/dungnh3/kitchen/pubsub/memory"
	"go.uber.org/goleak"

	"github.com/acme/notify/internal/store/memstore"
)

func TestMain(m *testing.M) { goleak.VerifyTestMain(m) }

func TestStorePublishes(t *testing.T) {
	broker := memory.New()
	defer func() { _ = broker.Close(context.Background()) }()
	sub, err := broker.Subscribe("items", "test")
	if err != nil {
		t.Fatal(err)
	}
	s := NewStore(memstore.New(), broker, "items", log.Discard())

	it, err := s.CreateItem(t.Context(), "first")
	if err != nil {
		t.Fatal(err)
	}

	ctx, cancel := context.WithCancel(t.Context())
	var m *pubsub.Message
	err = sub.Receive(ctx, func(_ context.Context, d pubsub.Delivery) {
		d.Ack()
		m = d.Message()
		cancel()
	})
	if err != nil || m == nil {
		t.Fatalf("Receive: %v, message %v", err, m)
	}
	var ev ItemCreated
	if err := json.Unmarshal(m.Data, &ev); err != nil {
		t.Fatal(err)
	}
	if m.Key != it.ID || ev.ID != it.ID || ev.Title != "first" {
		t.Errorf("event = %+v, key %q; want item %+v", ev, m.Key, it)
	}
}

func TestStoreKeepsItemWhenPublishFails(t *testing.T) {
	broker := memory.New()
	_ = broker.Close(context.Background()) // every publish fails
	s := NewStore(memstore.New(), broker, "items", log.Discard())

	it, err := s.CreateItem(t.Context(), "first")
	if err != nil {
		t.Fatalf("CreateItem: %v", err)
	}
	if _, err := s.GetItem(t.Context(), it.ID); err != nil {
		t.Errorf("item not stored: %v", err)
	}
}
