# Code generation: make generate. The plugins are "tool" dependencies in
# go.mod, so their versions match the runtime libraries.
version: v2
clean: true
managed:
  enabled: true
  disable:
    - file_option: go_package
      module: buf.build/bufbuild/protovalidate
    - file_option: go_package
      module: buf.build/googleapis/googleapis
  override:
    - file_option: go_package_prefix
      value: github.com/acme/notify/gen
plugins:
  - local: [go, tool, protoc-gen-go]
    out: gen
    opt: paths=source_relative
  - local: [go, tool, protoc-gen-go-grpc]
    out: gen
    opt: paths=source_relative
  - local: [go, tool, protoc-gen-grpc-gateway]
    out: gen
    opt: paths=source_relative
  - local: [go, tool, protoc-gen-openapiv2]
    out: gen/openapi
