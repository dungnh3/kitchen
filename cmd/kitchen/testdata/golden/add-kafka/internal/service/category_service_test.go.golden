package service

import (
	"testing"

	"github.com/dungnh3/kitchen/errs"
	"google.golang.org/grpc/codes"

	pb "github.com/acme/notify/gen/notify/v1"
	"github.com/acme/notify/internal/store/memstore"
)

func TestCategoryLifecycle(t *testing.T) {
	ctx := t.Context()
	svc := NewCategoryService(memstore.NewCategories())

	created, err := svc.CreateCategory(ctx, &pb.CreateCategoryRequest{Category: &pb.Category{Title: "first"}})
	if err != nil {
		t.Fatal(err)
	}
	if created.GetId() == "" || created.GetCreateTime() == nil {
		t.Fatalf("server fields not set: %v", created)
	}

	got, err := svc.GetCategory(ctx, &pb.GetCategoryRequest{Id: created.GetId()})
	if err != nil {
		t.Fatal(err)
	}
	if got.GetTitle() != "first" {
		t.Errorf("title = %q, want %q", got.GetTitle(), "first")
	}

	if _, err := svc.DeleteCategory(ctx, &pb.DeleteCategoryRequest{Id: created.GetId()}); err != nil {
		t.Fatal(err)
	}
	if _, err := svc.GetCategory(ctx, &pb.GetCategoryRequest{Id: created.GetId()}); errs.Code(err) != codes.NotFound {
		t.Errorf("GetCategory after delete: code %v, want NotFound (err %v)", errs.Code(err), err)
	}
	if _, err := svc.DeleteCategory(ctx, &pb.DeleteCategoryRequest{Id: created.GetId()}); errs.Code(err) != codes.NotFound {
		t.Errorf("second DeleteCategory: code %v, want NotFound", errs.Code(err))
	}
}

func TestListCategoriesPages(t *testing.T) {
	ctx := t.Context()
	svc := NewCategoryService(memstore.NewCategories())
	for _, title := range []string{"a", "b", "c", "d", "e"} {
		if _, err := svc.CreateCategory(ctx, &pb.CreateCategoryRequest{Category: &pb.Category{Title: title}}); err != nil {
			t.Fatal(err)
		}
	}

	seen := map[string]bool{}
	token := ""
	for pages := 1; ; pages++ {
		resp, err := svc.ListCategories(ctx, &pb.ListCategoriesRequest{PageSize: 2, PageToken: token})
		if err != nil {
			t.Fatal(err)
		}
		for _, v := range resp.GetCategories() {
			if seen[v.GetId()] {
				t.Fatalf("%s returned twice", v.GetId())
			}
			seen[v.GetId()] = true
		}
		token = resp.GetNextPageToken()
		if token == "" {
			if pages != 3 {
				t.Errorf("got %d pages, want 3", pages)
			}
			break
		}
	}
	if len(seen) != 5 {
		t.Errorf("listed %d, want 5", len(seen))
	}
}

func TestListCategoriesBadToken(t *testing.T) {
	svc := NewCategoryService(memstore.NewCategories())
	_, err := svc.ListCategories(t.Context(), &pb.ListCategoriesRequest{PageToken: "%%%"})
	if errs.Code(err) != codes.InvalidArgument {
		t.Fatalf("code %v, want InvalidArgument (err %v)", errs.Code(err), err)
	}
}
