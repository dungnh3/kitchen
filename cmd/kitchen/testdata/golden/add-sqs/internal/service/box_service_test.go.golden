package service

import (
	"testing"

	"github.com/dungnh3/kitchen/errs"
	"google.golang.org/grpc/codes"

	pb "github.com/acme/catalog/gen/catalog/v1"
	"github.com/acme/catalog/internal/store/memstore"
)

func TestBoxLifecycle(t *testing.T) {
	ctx := t.Context()
	svc := NewBoxService(memstore.NewBoxes())

	created, err := svc.CreateBox(ctx, &pb.CreateBoxRequest{Box: &pb.Box{Title: "first"}})
	if err != nil {
		t.Fatal(err)
	}
	if created.GetId() == "" || created.GetCreateTime() == nil {
		t.Fatalf("server fields not set: %v", created)
	}

	got, err := svc.GetBox(ctx, &pb.GetBoxRequest{Id: created.GetId()})
	if err != nil {
		t.Fatal(err)
	}
	if got.GetTitle() != "first" {
		t.Errorf("title = %q, want %q", got.GetTitle(), "first")
	}

	if _, err := svc.DeleteBox(ctx, &pb.DeleteBoxRequest{Id: created.GetId()}); err != nil {
		t.Fatal(err)
	}
	if _, err := svc.GetBox(ctx, &pb.GetBoxRequest{Id: created.GetId()}); errs.Code(err) != codes.NotFound {
		t.Errorf("GetBox after delete: code %v, want NotFound (err %v)", errs.Code(err), err)
	}
	if _, err := svc.DeleteBox(ctx, &pb.DeleteBoxRequest{Id: created.GetId()}); errs.Code(err) != codes.NotFound {
		t.Errorf("second DeleteBox: code %v, want NotFound", errs.Code(err))
	}
}

func TestListBoxesPages(t *testing.T) {
	ctx := t.Context()
	svc := NewBoxService(memstore.NewBoxes())
	for _, title := range []string{"a", "b", "c", "d", "e"} {
		if _, err := svc.CreateBox(ctx, &pb.CreateBoxRequest{Box: &pb.Box{Title: title}}); err != nil {
			t.Fatal(err)
		}
	}

	seen := map[string]bool{}
	token := ""
	for pages := 1; ; pages++ {
		resp, err := svc.ListBoxes(ctx, &pb.ListBoxesRequest{PageSize: 2, PageToken: token})
		if err != nil {
			t.Fatal(err)
		}
		for _, v := range resp.GetBoxes() {
			if seen[v.GetId()] {
				t.Fatalf("%s returned twice", v.GetId())
			}
			seen[v.GetId()] = true
		}
		token = resp.GetNextPageToken()
		if token == "" {
			if pages != 3 {
				t.Errorf("got %d pages, want 3", pages)
			}
			break
		}
	}
	if len(seen) != 5 {
		t.Errorf("listed %d, want 5", len(seen))
	}
}

func TestListBoxesBadToken(t *testing.T) {
	svc := NewBoxService(memstore.NewBoxes())
	_, err := svc.ListBoxes(t.Context(), &pb.ListBoxesRequest{PageToken: "%%%"})
	if errs.Code(err) != codes.InvalidArgument {
		t.Fatalf("code %v, want InvalidArgument (err %v)", errs.Code(err), err)
	}
}
