package mysqlstore

import (
	"context"
	"database/sql"
	"time"

	"github.com/dungnh3/kitchen/errs"
	"github.com/dungnh3/kitchen/mysqlx"
	"github.com/google/uuid"

	"{% .Module %}/internal/store"
	"{% .Module %}/internal/store/mysqlstore/sqlcdb"
)

// {% .E.Names %} is a store.{% .E.Names %} on a MySQL database.
type {% .E.Names %} struct {
	q   *sqlcdb.Queries
	now func() time.Time
}

var _ store.{% .E.Names %} = (*{% .E.Names %})(nil)

// New{% .E.Names %} returns {% .E.Names %} on db, which the caller owns.
func New{% .E.Names %}(db *sql.DB) *{% .E.Names %} {
	return &{% .E.Names %}{q: sqlcdb.New(db), now: time.Now}
}

// Get{% .E.Name %} implements store.{% .E.Names %}.
func (s *{% .E.Names %}) Get{% .E.Name %}(ctx context.Context, id string) (store.{% .E.Name %}, error) {
	row, err := s.q.Get{% .E.Name %}(ctx, id)
	if err != nil {
		// mysqlx.MapError turns sql.ErrNoRows into errs.ErrNotFound, duplicate
		// keys into errs.ErrAlreadyExists, and so on.
		return store.{% .E.Name %}{}, mysqlx.MapError(err)
	}
	return {% .E.Lower %}FromRow(row), nil
}

// List{% .E.Names %} implements store.{% .E.Names %}.
func (s *{% .E.Names %}) List{% .E.Names %}(ctx context.Context, after string, limit int32) ([]store.{% .E.Name %}, error) {
	rows, err := s.q.List{% .E.Names %}(ctx, sqlcdb.List{% .E.Names %}Params{After: after, Limit: limit})
	if err != nil {
		return nil, mysqlx.MapError(err)
	}
	out := make([]store.{% .E.Name %}, len(rows))
	for i, r := range rows {
		out[i] = {% .E.Lower %}FromRow(r)
	}
	return out, nil
}

// Create{% .E.Name %} implements store.{% .E.Names %}. MySQL has no RETURNING, so the id
// and the creation time are set here; the time is truncated to the
// microseconds that DATETIME(6) keeps.
func (s *{% .E.Names %}) Create{% .E.Name %}(ctx context.Context, title string) (store.{% .E.Name %}, error) {
	v := store.{% .E.Name %}{ID: uuid.NewString(), Title: title, CreateTime: s.now().UTC().Truncate(time.Microsecond)}
	err := s.q.Create{% .E.Name %}(ctx, sqlcdb.Create{% .E.Name %}Params{ID: v.ID, Title: v.Title, CreateTime: v.CreateTime})
	if err != nil {
		return store.{% .E.Name %}{}, mysqlx.MapError(err)
	}
	return v, nil
}

// Delete{% .E.Name %} implements store.{% .E.Names %}.
func (s *{% .E.Names %}) Delete{% .E.Name %}(ctx context.Context, id string) error {
	n, err := s.q.Delete{% .E.Name %}(ctx, id)
	if err != nil {
		return mysqlx.MapError(err)
	}
	if n == 0 {
		return errs.ErrNotFound
	}
	return nil
}

func {% .E.Lower %}FromRow(r sqlcdb.{% .E.Name %}) store.{% .E.Name %} {
	return store.{% .E.Name %}{ID: r.ID, Title: r.Title, CreateTime: r.CreateTime.UTC()}
}
