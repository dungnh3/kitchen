name: ci
on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read
{%- if eq .CI "reusable" %}

jobs:
  ci:
    # Reusable workflow pinned to a full commit SHA.
    uses: {% .CIWorkflow %}
    secrets: inherit
{%- else %}

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{% .Actions.Checkout %}
        with:
          persist-credentials: false
      - uses: actions/setup-go@{% .Actions.SetupGo %}
        with:
          go-version-file: go.mod
      - run: go mod tidy -diff
      - run: go vet ./...
      - run: go test -race -count=1 ./...
      - uses: golangci/golangci-lint-action@{% .Actions.GolangciLint %}
        with:
          version: {% .GolangciLintVersion %}

  docker:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{% .Actions.Checkout %}
        with:
          persist-credentials: false
      - uses: docker/setup-buildx-action@{% .Actions.SetupBuildx %}
      - uses: docker/build-push-action@{% .Actions.BuildPush %}
        with:
          context: .
          push: false
          build-args: VERSION=${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
{%- end %}
