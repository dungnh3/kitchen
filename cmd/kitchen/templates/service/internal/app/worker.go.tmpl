	"sync"
{%- if .Lease %}
	"time"
{%- end %}

{% if .Lease %}	leaseredis "github.com/dungnh3/kitchen/lease/redis"
{% end %}	"github.com/dungnh3/kitchen/log"
{%- if .PubSub %}
	"github.com/dungnh3/kitchen/pubsub"
{%- end %}
{%- if .Outbox %}
