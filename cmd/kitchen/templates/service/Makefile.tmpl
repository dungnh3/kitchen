VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
IMAGE   ?= {% .Name %}

# Code generators and the linter run at pinned versions with "go run", so
# nothing has to be installed. The protoc plugins are "tool" deps in go.mod.
BUF           := go run github.com/bufbuild/buf/cmd/buf@{% .Versions.Buf %}
{%- if .Postgres %}
SQLC          := go run github.com/sqlc-dev/sqlc/cmd/sqlc@{% .Versions.Sqlc %}
{%- end %}
GOLANGCI_LINT := go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@{% .GolangciLintVersion %}
{%- if .Postgres %}

DB_URL ?= postgres://app:app@localhost:5432/app?sslmode=disable
{%- end %}
# Local runs: no auth, readable logs.
LOCAL_ENV := AUTH_DISABLED=true LOG_FORMAT=text{% if .Postgres %} DB_URL="$(DB_URL)"{% end %}

.PHONY: generate build test lint breaking run tidy docker{% if .Postgres %} migrate-up migrate-down migrate-status db-up db-down{% end %}

# Regenerate gen/ from proto/{% if .Postgres %} and internal/store/pgstore/sqlcdb from the SQL{% end %}.
# The generated code is committed; CI fails if it is stale.
generate:
	$(BUF) generate
{%- if .Postgres %}
	$(SQLC) generate
{%- end %}

build:
	go build -ldflags="-X main.version=$(VERSION)" -o bin/server ./cmd/server

test:
	go test -race -count=1 ./...

lint:
	$(GOLANGCI_LINT) run ./...
	$(BUF) lint
{%- if .Postgres %}
	$(SQLC) vet
{%- end %}

# Compare the API with main for breaking changes.
breaking:
	$(BUF) breaking --against '.git#branch=main'

tidy:
	go mod tidy

run:
	$(LOCAL_ENV){% if .Postgres %} DB_MIGRATE_ON_START=true{% end %} go run ./cmd/server
{%- if .Postgres %}

migrate-up migrate-down migrate-status:
	$(LOCAL_ENV) go run ./cmd/server migrate $(@:migrate-%=%)

# A disposable local Postgres matching DB_URL.
db-up:
	docker run --rm -d --name $(IMAGE)-postgres -p 5432:5432 \
		-e POSTGRES_USER=app -e POSTGRES_PASSWORD=app -e POSTGRES_DB=app {% .PostgresImage %}

db-down:
	docker stop $(IMAGE)-postgres
{%- end %}

docker:
	docker build --build-arg VERSION=$(VERSION) -t $(IMAGE):$(VERSION) .
