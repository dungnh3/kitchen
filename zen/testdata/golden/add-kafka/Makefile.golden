VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
IMAGE   ?= notify

# Code generators and the linter run at pinned versions with "go run", so
# nothing has to be installed. The protoc plugins are "tool" deps in go.mod.
BUF           := go run github.com/bufbuild/buf/cmd/buf@v1.75.0
GOLANGCI_LINT := go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0
ZEN           := go run github.com/dungnh3/kitchen/zen@v0.1.0
# Local runs: no auth, readable logs, the dependencies of compose.yaml.
LOCAL_ENV := AUTH_DISABLED=true LOG_FORMAT=text
LOCAL_ENV += PUBSUB_BROKERS=localhost:9092 PUBSUB_TLS=false
# Topics that "make up" creates.
LOCAL_TOPICS := notify-items notify-items.dlq
# "zen add consumer", "zen add client" and "zen add webhook" add their local settings here.
LOCAL_ENV += PUBSUB_ORDER_EVENTS_TOPIC=order-events PUBSUB_ORDER_EVENTS_SUBSCRIPTION=notify-order-events-worker PUBSUB_ORDER_EVENTS_DEAD_LETTER_TOPIC=order-events.dlq
LOCAL_TOPICS += order-events order-events.dlq
# zen:local-env

.PHONY: generate build test lint check breaking run tidy docker run-worker up down

# Regenerate gen/ from proto/.
# The generated code is committed; CI fails if it is stale.
generate:
	$(BUF) generate

build:
	go build -ldflags="-X main.version=$(VERSION)" -o bin/server ./cmd/server

test:
	go test -race -count=1 ./...

lint:
	$(GOLANGCI_LINT) run ./...
	$(BUF) lint

# Fail when a file managed by zen was edited (see .zen.yaml). Add
# ARGS=-write to update the managed files to the current template.
check:
	$(ZEN) check $(ARGS)

# Compare the API with main for breaking changes.
breaking:
	$(BUF) breaking --against '.git#branch=main'

tidy:
	go mod tidy

run:
	$(LOCAL_ENV) go run ./cmd/server serve

run-worker:
	$(LOCAL_ENV) go run ./cmd/server worker

# Start the local dependencies of compose.yaml and create the topics.
up:
	docker compose up -d --wait
	for topic in $(LOCAL_TOPICS); do \
		docker compose exec kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 \
			--create --if-not-exists --topic $$topic >/dev/null || exit 1; \
	done

down:
	docker compose down

docker:
	docker build --build-arg VERSION=$(VERSION) -t $(IMAGE):$(VERSION) .
