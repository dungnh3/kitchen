# syntax=docker/dockerfile:1
# Managed by zen: "zen check" fails when this file differs from
# the version zen wrote, and "zen check -write" updates it to the
# current template. To own the file instead, remove it from "managed" in
# .zen.yaml.
# Pin both images by digest (Renovate/Dependabot keep them current).
FROM golang:1.27-alpine3.24 AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
# Private modules: set GOPRIVATE and pass credentials as a BuildKit secret,
#   docker build --build-arg GOPRIVATE=github.com/your-org/* --secret id=netrc,src=$HOME/.netrc .
# The secret is mounted for one step only and never stored in a layer.
ARG GOPRIVATE
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=secret,id=netrc,target=/root/.netrc,required=false \
    go mod download
COPY . .
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags="-s -w -X main.version=${VERSION}" -o /out/server ./cmd/server

FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/server /server
USER nonroot:nonroot
EXPOSE 8080 10000
ENTRYPOINT ["/server"]
