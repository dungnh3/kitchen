package consumer

import (
	"context"
	"errors"

	"github.com/dungnh3/kitchen/log"
	"github.com/dungnh3/kitchen/pubsub"
)

// PaymentsMessage is the JSON message that the payments consumer reads.
// Change its fields to the producer's payload.
type PaymentsMessage struct {
	ID string `json:"id"`
}

// Payments handles PaymentsMessage messages.
type Payments struct {
	logger *log.Logger
}

// NewPayments returns a Payments handler. logger nil means log.Default().
func NewPayments(logger *log.Logger) *Payments {
	return &Payments{logger: log.OrDefault(logger)}
}

// Handler returns the handler to subscribe. A message that is not a
// PaymentsMessage JSON document is dead-lettered.
func (h *Payments) Handler() pubsub.Handler { return pubsub.JSON(h.handle) }

func (h *Payments) handle(ctx context.Context, msg PaymentsMessage, _ *pubsub.Message) error {
	if msg.ID == "" {
		return pubsub.Permanent(errors.New("PaymentsMessage without id"))
	}
	h.logger.InfoContext(ctx, "message handled", log.String("consumer", "payments"), log.String("id", msg.ID))
	return nil
}
