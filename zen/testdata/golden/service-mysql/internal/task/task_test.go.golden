package task

import (
	"context"
	"testing"
	"testing/synctest"
	"time"

	"github.com/dungnh3/kitchen/jobs"
	"github.com/dungnh3/kitchen/jobs/jobstest"
	"github.com/dungnh3/kitchen/log"
)

// runUntilIdle runs a client with the registered tasks on the in-memory
// driver, inserts args, and returns the job once it ended.
func runUntilIdle(t *testing.T, args jobs.Args) jobs.Row {
	t.Helper()
	reg := jobs.NewRegistry()
	if err := Register(reg, log.Discard()); err != nil {
		t.Fatal(err)
	}
	drv := jobstest.New()
	client, err := jobs.NewClient(drv, jobs.WithRegistry(reg), jobs.WithLogger(log.Discard()))
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(t.Context())
	done := make(chan error, 1)
	go func() { done <- client.Run(ctx) }()
	res, err := client.Insert(ctx, args, nil)
	if err != nil {
		t.Fatal(err)
	}
	synctest.Wait()
	cancel()
	if err := <-done; err != nil {
		t.Fatal(err)
	}
	row, err := client.Get(context.Background(), res.ID)
	if err != nil {
		t.Fatal(err)
	}
	return *row
}

func TestHeartbeat(t *testing.T) {
	synctest.Test(t, func(t *testing.T) {
		if row := runUntilIdle(t, Heartbeat{}); row.State != jobs.StateCompleted {
			t.Fatalf("heartbeat job = %+v", row)
		}
	})
}

func TestPeriodicTasksAreRegistered(t *testing.T) {
	reg := jobs.NewRegistry()
	if err := Register(reg, log.Discard()); err != nil {
		t.Fatal(err)
	}
	kinds := map[string]bool{}
	for _, k := range reg.Kinds() {
		kinds[k] = true
	}
	for _, p := range Periodic() {
		if p.Interval < time.Second {
			t.Errorf("interval %v is shorter than a second", p.Interval)
		}
		if k := p.New().Kind(); !kinds[k] {
			t.Errorf("periodic task %q has no registered worker", k)
		}
	}
}
