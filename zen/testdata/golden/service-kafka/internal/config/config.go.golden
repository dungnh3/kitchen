// Package config loads the service configuration from environment variables.
package config

import (
	"errors"
	"fmt"
	"net/url"
	"time"

	"github.com/caarlos0/env/v11"
)

// EnvProduction is the APP_ENV value of production deployments. Unsafe
// settings such as AUTH_DISABLED are refused there.
const EnvProduction = "production"

// Config is the service configuration. Logging is configured separately by
// LOG_LEVEL, LOG_FORMAT, LOG_SCHEMA and LOG_OUTPUT, and telemetry by the standard OTEL_*
// variables (OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SDK_DISABLED, ...).
type Config struct {
	// Env names the deployment: development, staging, production, ...
	Env string `env:"APP_ENV" envDefault:"development"`

	GRPCAddr string `env:"GRPC_ADDR" envDefault:":10000"`
	HTTPAddr string `env:"HTTP_ADDR" envDefault:":8080"`
	// AdminAddr enables the admin port (/livez, /readyz with details,
	// /version, /metrics, /debug/pprof/). Never expose it publicly.
	AdminAddr string `env:"ADMIN_ADDR"`
	// GRPCReflection registers gRPC server reflection (for grpcurl).
	GRPCReflection bool `env:"GRPC_REFLECTION"`

	// ShutdownDelay keeps serving after the server is marked not ready, so
	// load balancers stop routing to it first. It is part of ShutdownTimeout.
	ShutdownDelay   time.Duration `env:"SHUTDOWN_DELAY" envDefault:"5s"`
	ShutdownTimeout time.Duration `env:"SHUTDOWN_TIMEOUT" envDefault:"30s"`

	// TrustedProxies lists the CIDRs of every proxy hop in front of the
	// service (load balancer, ingress); it decides the client IP used by
	// rate limits. Empty trusts no X-Forwarded-For header.
	TrustedProxies []string `env:"TRUSTED_PROXIES"`
	// ErrorDomain is the ErrorInfo.domain of API errors (AIP-193).
	ErrorDomain string    `env:"ERROR_DOMAIN" envDefault:"notify"`
	PubSub      PubSub    `envPrefix:"PUBSUB_"`
	Auth        Auth      `envPrefix:"AUTH_"`
	RateLimit   RateLimit `envPrefix:"RATE_LIMIT_"`
}

// PubSub configures the message broker (Kafka).
type PubSub struct {
	// Brokers are the seed brokers, host:port.
	Brokers []string `env:"BROKERS"`
	// TLS encrypts the connections. Turn it off only for a local broker.
	TLS bool `env:"TLS" envDefault:"true"`
	// ItemsTopic receives an ItemCreated event for every new item.
	ItemsTopic string `env:"ITEMS_TOPIC" envDefault:"notify-items"`
	// ItemsSubscription is the consumer group of the worker.
	ItemsSubscription string `env:"ITEMS_SUBSCRIPTION" envDefault:"notify-items-worker"`
	// Kafka has no dead-letter queue: after MaxDeliveryAttempts deliveries
	// the worker publishes a message to ItemsDeadLetterTopic and moves on.
	MaxDeliveryAttempts  int    `env:"MAX_DELIVERY_ATTEMPTS" envDefault:"5"`
	ItemsDeadLetterTopic string `env:"ITEMS_DEAD_LETTER_TOPIC" envDefault:"notify-items.dlq"`
	// Concurrency is the number of messages the worker handles at once.
	Concurrency int `env:"CONCURRENCY" envDefault:"10"`

	// The subscriptions of the consumers that "zen add consumer" adds
	// above "zen:subscriptions".
	// zen:subscriptions
}

// Subscription is a topic and the worker's subscription to it.
type Subscription struct {
	Topic string `env:"TOPIC"`
	// Subscription is the consumer group.
	Subscription string `env:"SUBSCRIPTION"`
	// DeadLetterTopic receives the messages that failed
	// PUBSUB_MAX_DELIVERY_ATTEMPTS times.
	DeadLetterTopic string `env:"DEAD_LETTER_TOPIC"`
}

// Validate reports the missing settings of s; prefix is the prefix of its
// variables, for example PUBSUB_ORDERS_.
func (s Subscription) Validate(prefix string) error {
	var errs []error
	if s.Topic == "" {
		errs = append(errs, fmt.Errorf("%sTOPIC is required", prefix))
	}
	if s.Subscription == "" {
		errs = append(errs, fmt.Errorf("%sSUBSCRIPTION is required", prefix))
	}
	if s.DeadLetterTopic == "" {
		errs = append(errs, fmt.Errorf("%sDEAD_LETTER_TOPIC is required", prefix))
	}
	return errors.Join(errs...)
}

// Auth configures bearer-token authentication. Every method needs a valid
// JWT signed by Issuer for Audience, except the health service.
type Auth struct {
	// Disabled turns authentication off. It is refused in production.
	Disabled bool   `env:"DISABLED"`
	Issuer   string `env:"ISSUER"`
	// JWKSURL is the issuer's key set, for example
	// https://issuer.example.com/.well-known/jwks.json.
	JWKSURL  string `env:"JWKS_URL"`
	Audience string `env:"AUDIENCE"`
	// TokenTypes, when set, lists the accepted JWT "typ" values, for example
	// at+jwt for RFC 9068 access tokens.
	TokenTypes []string `env:"TOKEN_TYPES"`
}

// RateLimit configures the per-caller rate limits.
type RateLimit struct {
	Disabled bool `env:"DISABLED"`
	// DryRun counts and logs but never rejects.
	DryRun bool `env:"DRY_RUN"`
	// Exempt lists identities that are never limited: user:<id>,
	// ip:<address> or ip:<CIDR>.
	Exempt []string `env:"EXEMPT"`
}

// Load reads and validates the configuration from the environment.
func Load() (Config, error) { return load(env.Options{}) }

func load(opts env.Options) (Config, error) {
	c, err := env.ParseAsWithOptions[Config](opts)
	if err != nil {
		return c, err
	}
	return c, c.validate()
}

func (c Config) validate() error {
	var errs []error
	if c.ShutdownDelay < 0 || c.ShutdownTimeout <= 0 || c.ShutdownDelay >= c.ShutdownTimeout {
		errs = append(errs, errors.New("SHUTDOWN_DELAY and SHUTDOWN_TIMEOUT: want 0 <= delay < timeout"))
	}
	return errors.Join(errs...)
}

// ValidateServer checks the settings needed to serve requests. It is not
// part of Load so that commands such as "migrate" run without them.
func (c Config) ValidateServer() error {
	return errors.Join(c.validateAuth(), c.validateDeps())
}

// ValidateWorker checks the settings needed by the worker.
func (c Config) ValidateWorker() error { return c.validateDeps() }

// validateDeps checks the settings of the external services that the
// server and the worker connect to.
func (c Config) validateDeps() error {
	var errs []error
	if len(c.PubSub.Brokers) == 0 {
		errs = append(errs, errors.New("PUBSUB_BROKERS is required"))
	}
	if c.PubSub.MaxDeliveryAttempts < 1 {
		errs = append(errs, errors.New("PUBSUB_MAX_DELIVERY_ATTEMPTS must be at least 1"))
	}
	if c.PubSub.ItemsTopic == "" {
		errs = append(errs, errors.New("PUBSUB_ITEMS_TOPIC is required"))
	}
	if c.PubSub.Concurrency < 1 {
		errs = append(errs, errors.New("PUBSUB_CONCURRENCY must be at least 1"))
	}
	// zen:subscriptions-validate
	return errors.Join(errs...)
}

func (c Config) validateAuth() error {
	a := c.Auth
	if a.Disabled {
		if c.Env == EnvProduction {
			return errors.New("AUTH_DISABLED is not allowed when APP_ENV=production")
		}
		return nil
	}
	var errs []error
	if a.Issuer == "" {
		errs = append(errs, errors.New("AUTH_ISSUER is required (or set AUTH_DISABLED=true outside production)"))
	}
	if a.Audience == "" {
		errs = append(errs, errors.New("AUTH_AUDIENCE is required: it stops tokens issued for other services from being accepted"))
	}
	if !secureURL(a.JWKSURL) {
		errs = append(errs, fmt.Errorf("AUTH_JWKS_URL: want an https URL (http only for localhost), got %q", a.JWKSURL))
	}
	return errors.Join(errs...)
}

// secureURL reports whether s is an https URL, or an http URL of localhost.
func secureURL(s string) bool {
	u, err := url.Parse(s)
	return err == nil && u.Host != "" && (u.Scheme == "https" || u.Scheme == "http" && (u.Hostname() == "localhost" || u.Hostname() == "127.0.0.1"))
}
