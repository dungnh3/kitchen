package service

import (
	"testing"

	"github.com/dungnh3/kitchen/errs"
	"google.golang.org/grpc/codes"

	pb "github.com/acme/shop/gen/shop/v1"
	"github.com/acme/shop/internal/store/memstore"
)

func TestOrderItemLifecycle(t *testing.T) {
	ctx := t.Context()
	svc := NewOrderItemService(memstore.NewOrderItems())

	created, err := svc.CreateOrderItem(ctx, &pb.CreateOrderItemRequest{OrderItem: &pb.OrderItem{Title: "first"}})
	if err != nil {
		t.Fatal(err)
	}
	if created.GetId() == "" || created.GetCreateTime() == nil {
		t.Fatalf("server fields not set: %v", created)
	}

	got, err := svc.GetOrderItem(ctx, &pb.GetOrderItemRequest{Id: created.GetId()})
	if err != nil {
		t.Fatal(err)
	}
	if got.GetTitle() != "first" {
		t.Errorf("title = %q, want %q", got.GetTitle(), "first")
	}

	if _, err := svc.DeleteOrderItem(ctx, &pb.DeleteOrderItemRequest{Id: created.GetId()}); err != nil {
		t.Fatal(err)
	}
	if _, err := svc.GetOrderItem(ctx, &pb.GetOrderItemRequest{Id: created.GetId()}); errs.Code(err) != codes.NotFound {
		t.Errorf("GetOrderItem after delete: code %v, want NotFound (err %v)", errs.Code(err), err)
	}
	if _, err := svc.DeleteOrderItem(ctx, &pb.DeleteOrderItemRequest{Id: created.GetId()}); errs.Code(err) != codes.NotFound {
		t.Errorf("second DeleteOrderItem: code %v, want NotFound", errs.Code(err))
	}
}

func TestListOrderItemsPages(t *testing.T) {
	ctx := t.Context()
	svc := NewOrderItemService(memstore.NewOrderItems())
	for _, title := range []string{"a", "b", "c", "d", "e"} {
		if _, err := svc.CreateOrderItem(ctx, &pb.CreateOrderItemRequest{OrderItem: &pb.OrderItem{Title: title}}); err != nil {
			t.Fatal(err)
		}
	}

	seen := map[string]bool{}
	token := ""
	for pages := 1; ; pages++ {
		resp, err := svc.ListOrderItems(ctx, &pb.ListOrderItemsRequest{PageSize: 2, PageToken: token})
		if err != nil {
			t.Fatal(err)
		}
		for _, v := range resp.GetOrderItems() {
			if seen[v.GetId()] {
				t.Fatalf("%s returned twice", v.GetId())
			}
			seen[v.GetId()] = true
		}
		token = resp.GetNextPageToken()
		if token == "" {
			if pages != 3 {
				t.Errorf("got %d pages, want 3", pages)
			}
			break
		}
	}
	if len(seen) != 5 {
		t.Errorf("listed %d, want 5", len(seen))
	}
}

func TestListOrderItemsBadToken(t *testing.T) {
	svc := NewOrderItemService(memstore.NewOrderItems())
	_, err := svc.ListOrderItems(t.Context(), &pb.ListOrderItemsRequest{PageToken: "%%%"})
	if errs.Code(err) != codes.InvalidArgument {
		t.Fatalf("code %v, want InvalidArgument (err %v)", errs.Code(err), err)
	}
}
