func TestMain(m *testing.M) { goleak.VerifyTestMain(m) }

// TestApp starts the whole service on random ports against a MySQL
// container and calls it over REST.
func TestApp(t *testing.T) {
	if testing.Short() {
		t.Skip("starts the service and a MySQL container")
	}
	base := config.Config{
		Env:             "test",
		GRPCAddr:        "127.0.0.1:0",
		HTTPAddr:        "127.0.0.1:0",
		ShutdownTimeout: 5 * time.Second,
		ErrorDomain:     Name,
		Database:        config.Database{URL: startMySQL(t), MigrateOnStart: true},
		Redis:           config.Redis{Addrs: []string{miniredis.RunT(t).Addr()}},
		Cache:           config.Cache{TTL: time.Minute},
		Clients: config.Clients{
			Billing:     config.Client{Addr: "passthrough:///billing", Insecure: true},
			UserProfile: config.Client{Addr: "passthrough:///user-profile", Insecure: true},
			// zen:clients-test
		},
	}
	var opts []Option

	t.Run("crud", func(t *testing.T) {
		cfg := base
		cfg.Auth.Disabled = true
		url := start(t, cfg, opts...)

		var item map[string]any
		call(t, http.MethodPost, url+"/v1/items", `{"title":"first"}`, http.StatusOK, &item)
		id, _ := item["id"].(string)
		if id == "" || item["title"] != "first" {
			t.Fatalf("created item = %v", item)
		}
		call(t, http.MethodGet, url+"/v1/items/"+id, "", http.StatusOK, &item)

		var list struct {
			Items []map[string]any `json:"items"`
		}
		call(t, http.MethodGet, url+"/v1/items?page_size=10", "", http.StatusOK, &list)
		if len(list.Items) != 1 {
			t.Errorf("listed %d items, want 1", len(list.Items))
		}

		// protovalidate rules from the proto file run before the method.
		var e apiError
		call(t, http.MethodPost, url+"/v1/items", `{"title":""}`, http.StatusBadRequest, &e)
		call(t, http.MethodGet, url+"/v1/items/not-a-uuid", "", http.StatusBadRequest, &e)

		call(t, http.MethodDelete, url+"/v1/items/"+id, "", http.StatusOK, nil)
		call(t, http.MethodGet, url+"/v1/items/"+id, "", http.StatusNotFound, &e)
		if e.Error.Status != "NOT_FOUND" {
			t.Errorf("error status = %q, want NOT_FOUND", e.Error.Status)
		}
	})

	t.Run("auth", func(t *testing.T) {
		idp := httptest.NewServer(introspectionHandler(t))
		defer idp.Close()
		cfg := base
		cfg.Auth = config.Auth{IntrospectionURL: idp.URL, ClientID: Name, ClientSecret: "secret", Audience: Name, CacheKey: "0123456789abcdef0123456789abcdef"}
		url := start(t, cfg, opts...)

		get, _ := http.NewRequestWithContext(t.Context(), http.MethodGet, url+"/v1/items", nil)
		get.Header.Set("Authorization", "Bearer active-token")
		ok, err := http.DefaultClient.Do(get)
		if err != nil {
			t.Fatal(err)
		}
		_ = ok.Body.Close()
		if ok.StatusCode != http.StatusOK {
			t.Errorf("active token: status %d, want 200", ok.StatusCode)
		}

		var e apiError
		call(t, http.MethodGet, url+"/v1/items", "", http.StatusUnauthorized, &e)
		req, _ := http.NewRequestWithContext(t.Context(), http.MethodGet, url+"/v1/items", nil)
		req.Header.Set("Authorization", "Bearer not-a-jwt")
		resp, err := http.DefaultClient.Do(req)
		if err != nil {
			t.Fatal(err)
		}
		_ = resp.Body.Close()
		if resp.StatusCode != http.StatusUnauthorized {
			t.Errorf("invalid token: status %d, want 401", resp.StatusCode)
		}
	})
}

type apiError struct {
	Error struct {
		Code   int    `json:"code"`
		Status string `json:"status"`
	} `json:"error"`
}

// start runs the service until the test ends and returns its REST base URL.
func start(t *testing.T, cfg config.Config, opts ...Option) string {
	t.Helper()
	var lc net.ListenConfig
	grpcLis, err := lc.Listen(t.Context(), "tcp", cfg.GRPCAddr)
	if err != nil {
		t.Fatal(err)
	}
	httpLis, err := lc.Listen(t.Context(), "tcp", cfg.HTTPAddr)
	if err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithCancel(context.Background())
	done := make(chan error, 1)
	go func() {
		done <- Run(ctx, cfg, log.Discard(), "test", append(opts, WithServerOptions(server.WithGRPCListener(grpcLis), server.WithHTTPListener(httpLis)))...)
	}()
	t.Cleanup(func() {
		cancel()
		if err := <-done; err != nil {
			t.Errorf("Run: %v", err)
		}
	})

	url := "http://" + httpLis.Addr().String()
	deadline := time.NewTimer(30 * time.Second)
	defer deadline.Stop()
	tick := time.NewTicker(50 * time.Millisecond)
	defer tick.Stop()
	for {
		req, _ := http.NewRequestWithContext(t.Context(), http.MethodGet, url+"/readyz", nil)
		if resp, err := http.DefaultClient.Do(req); err == nil {
			_ = resp.Body.Close()
			if resp.StatusCode == http.StatusOK {
				return url
			}
		}
		select {
		case err := <-done:
			done <- err
			t.Fatalf("service stopped: %v", err)
		case <-deadline.C:
			t.Fatal("service not ready after 30s")
		case <-tick.C:
		}
	}
}

func call(t *testing.T, method, url, body string, wantStatus int, out any) {
	t.Helper()
	req, err := http.NewRequestWithContext(t.Context(), method, url, strings.NewReader(body))
	if err != nil {
		t.Fatal(err)
	}
	req.Header.Set("Content-Type", "application/json")
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer func() { _ = resp.Body.Close() }()
	b, _ := io.ReadAll(resp.Body)
	if resp.StatusCode != wantStatus {
		t.Fatalf("%s %s: status %d, want %d: %s", method, url, resp.StatusCode, wantStatus, b)
	}
	if out != nil {
		if err := json.Unmarshal(b, out); err != nil {
			t.Fatalf("%s %s: %v: %s", method, url, err, b)
		}
	}
}

// introspectionHandler is an RFC 7662 endpoint: "active-token" is an active
// token for this service, every other token is inactive.
func introspectionHandler(t *testing.T) http.Handler {
	t.Helper()
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if user, pass, ok := r.BasicAuth(); !ok || user != Name || pass != "secret" {
			http.Error(w, "unauthorized", http.StatusUnauthorized)
			return
		}
		resp := map[string]any{"active": false}
		if r.PostFormValue("token") == "active-token" {
			resp = map[string]any{"active": true, "sub": "user-1", "aud": Name, "exp": time.Now().Add(time.Hour).Unix()}
		}
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(resp)
	})
}

// startMySQL starts a disposable MySQL and returns its DSN. It skips the
// test when Docker is not available.
func startMySQL(t *testing.T) string {
	t.Helper()
	testcontainers.SkipIfProviderIsNotHealthy(t)
	ctx := context.Background()
	c, err := tcmysql.Run(ctx, "mysql:8.4",
		tcmysql.WithDatabase("app"), tcmysql.WithUsername("app"), tcmysql.WithPassword("app"))
	testcontainers.CleanupContainer(t, c)
	if err != nil {
		t.Fatal(err)
	}
	dsn, err := c.ConnectionString(ctx, "tls=false")
	if err != nil {
		t.Fatal(err)
	}
	return dsn
}
